-- =========================================================
-- 1. Traveler
-- =========================================================
CREATE TABLE IF NOT EXISTS traveler (
    traveler_id SERIAL PRIMARY KEY,
    name        TEXT NOT NULL,
    surname     TEXT,
    dob         DATE,
    gender      TEXT,
    email       TEXT UNIQUE NOT NULL,
    password    TEXT NOT NULL
);

-- =========================================================
-- 2. Supplier
--    (wordt gebruikt door agency, activity_type en activity)
-- =========================================================
CREATE TABLE IF NOT EXISTS supplier (
    supplier_id  SERIAL PRIMARY KEY,
    name         TEXT NOT NULL,
    company_id   TEXT UNIQUE,   -- uniek zodat we ON CONFLICT kunnen gebruiken
    company_name TEXT
);

